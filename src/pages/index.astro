---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import Exhibit from '../components/Exhibit.astro';
import Toolkit from '../components/Toolkit.astro';
import Scoreboard from '../components/Scoreboard.astro';
import Ledger from '../components/Ledger.astro';
import LabReport from '../components/LabReport.astro';
import Disclosure from '../components/Disclosure.astro';
import Contact from '../components/Contact.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const published = posts.filter((p) => !p.data.draft);
const forthcoming = posts.filter((p) => p.data.draft);
---

<Base>
  <Hero exhibits={projects.map((p) => ({ id: p.id, exhibit: p.data.exhibit, short: p.data.short }))} />

  <section id="work" class="section page" aria-labelledby="work-title">
    <SectionHead id="work" kicker="Section I: Case files" meta={`${projects.length} exhibits entered into the record`} title="Selected Cases" />
    {projects.map((project, i) => <Exhibit project={project} flip={i % 2 === 1} />)}
  </section>

  <Toolkit />
  <Scoreboard />
  <Ledger />
  <LabReport published={published} forthcoming={forthcoming} />
  <Disclosure />
  <Contact />
</Base>
