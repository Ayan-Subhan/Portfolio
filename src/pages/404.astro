---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found" description="This page is not in the record." compact>
  <section class="page nf">
    <p class="label kicker">Error 404 — Record not found</p>
    <h1>This page has been <span class="bar" aria-hidden="true">████████</span><span class="visually-hidden">redacted</span>.</h1>
    <p class="deck">Or it never existed. Either way, there's nothing on file at this address.</p>
    <a class="btn btn-primary" href="/"><Icon name="arrow-left" /> Back to the front page</a>
  </section>
</Base>

<style>
  .nf {
    padding-block: var(--s-9);
  }

  h1 {
    margin: var(--s-4) 0;
    font-size: var(--fs-h1);
  }

  .bar {
    color: var(--ink);
    letter-spacing: -0.1em;
  }

  .deck {
    font-size: var(--fs-lede);
    font-style: italic;
    margin-bottom: var(--s-6);
  }
</style>
