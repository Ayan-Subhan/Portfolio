---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  label?: string;
  redacted?: boolean;
  eager?: boolean;
  sizes?: string;
}
const { src, alt, caption, label, redacted = false, eager = false, sizes = '(min-width: 1024px) 720px, 100vw' } =
  Astro.props;
---

<figure class="fig">
  <div class="mat">
    <Image
      src={src}
      alt={alt}
      widths={[480, 800, 1200, Math.min(src.width, 1600)]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
    {redacted && <span class="stamp redacted">Redacted · Confidential</span>}
  </div>
  {
    (caption || label) && (
      <figcaption>
        {label && <span class="label kicker">{label} </span>}
        {caption}
        {redacted && <span class="note"> Internal team names and asset counts removed.</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .fig {
    margin: 0;
  }

  .mat {
    position: relative;
    padding: var(--s-2);
    background: var(--paper-inset);
    border: 1px solid var(--rule);
  }

  .mat :global(img) {
    width: 100%;
    height: auto;
    filter: saturate(0.9);
  }

  .redacted {
    position: absolute;
    right: var(--s-4);
    bottom: var(--s-4);
    background: var(--paper);
  }

  figcaption {
    margin-top: var(--s-2);
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .note {
    font-style: italic;
  }
</style>
