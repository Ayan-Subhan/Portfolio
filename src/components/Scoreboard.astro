---
import SectionHead from './SectionHead.astro';
import { ctfs, strongCategories, trainingRooms } from '../data/record';
---

<section id="scoreboard" class="band" aria-labelledby="scoreboard-title">
  <div class="section page">
    <SectionHead id="scoreboard" kicker="Section III: Competitions" meta="Capture the flag" title="The Scoreboard" onDark />

    <div class="grid">
      <div data-reveal>
        <h3 class="label">Events entered</h3>
        <ul class="events">
          {ctfs.map((c) => <li>{c}</li>)}
        </ul>
      </div>

      <aside class="side" data-reveal>
        {
          strongCategories.length > 0 && (
            <div class="block">
              <h3 class="label">Strongest categories</h3>
              <ul class="chips">
                {strongCategories.map((c) => (
                  <li class="chip">{c}</li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="block">
          <h3 class="label">Training record: TryHackMe</h3>
          <ul class="chips">
            {trainingRooms.map((r) => <li class="chip">{r}</li>)}
          </ul>
        </div>
        <p class="aside-note">CTF writeups are filed in <a href="#writing">The Lab Report</a>.</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .band {
    background: var(--oxblood-deep);
    color: var(--on-oxblood);
  }

  .grid {
    display: grid;
    gap: var(--s-7);
  }

  .events {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--on-oxblood-muted);
  }

  .events li {
    padding: var(--s-3) 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    border-bottom: 1px solid rgb(244 241 234 / 0.25);
  }

  .block {
    margin-bottom: var(--s-5);
  }

  h3 {
    margin-bottom: var(--s-3);
    font-family: var(--font-mono);
    color: var(--on-oxblood-muted);
  }

  .aside-note {
    font-style: italic;
    color: var(--on-oxblood-muted);
  }

  .aside-note a {
    color: var(--on-oxblood);
  }

  .band :focus-visible {
    outline-color: var(--on-oxblood);
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }

    .side {
      padding-left: var(--s-6);
      border-left: 1px solid rgb(244 241 234 / 0.35);
    }
  }
</style>
